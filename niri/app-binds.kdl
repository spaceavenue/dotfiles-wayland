binds {
  // Programs
  Mod+Space   { spawn "fuzzel"; }
  Mod+A       { spawn "msc-player.fish";}
  Mod+B       { spawn "firefox-nightly"; }
  Mod+D       { spawn "vesktop"; }
  Mod+K       { spawn "keepassxc"; }
  Mod+N       { spawn "nautilus"; }
  Mod+W       { spawn "pkill" "-USR1" "waybar"; }
  Mod+S       { spawn "signal-desktop"; }
  Mod+T       { spawn "footclient"; }
  Mod+Shift+N { spawn "footclient" "yazi"; }
  Mod+Shift+L { spawn "swaylock"; }
  
  // Scripts

  // Clipboard history
  Mod+Apostrophe		 { spawn "clip-history.fish"; }
  Mod+Alt+Apostrophe { spawn "clip-history.fish" "--wtype";}
  Mod+Ctrl+Alt+Apostrophe { spawn "clip-history.fish" "--wtype" "--nline"; }
  
  // Color picker
  Mod+Shift+Apostrophe	   { spawn "color-picker.fish"; }
  Mod+Alt+Shift+Apostrophe { spawn "color-picker.fish" "--wtype"; }

  // Emoji picker
  Mod+Semicolon     { spawn "emoji-picker.fish"; }
  Mod+Alt+Semicolon	{ spawn "emoji-picker.fish" "--wtype";}
  
  // Nerd font glyph picker
  Mod+Shift+Semicolon	  	{ spawn "glyph-picker.fish"; }
  Mod+Alt+Shift+Semicolon { spawn "glyph-picker.fish" "--wtype";}
  
  Mod+F4  { spawn "power-menu.fish";	}	        // Power menu
  Mod+F5  { spawn "wall-picker.fish"; }         // Wallpaper selector
  Mod+F6  { spawn "pkill" "-USR1" "rustidle"; } // Toggle idle management

  Mod+O repeat=false { toggle-overview; } // Open/close the Overview
  Mod+Q repeat=false { close-window; }    // Close window

  // Screenshot
  Mod+Shift+S { spawn-sh "niri msg screenshot-stdout interactive | satty -f -"; }
  Print       { spawn-sh "niri msg screenshot-stdout screen | satty -f -"; }
  Mod+Print   { spawn-sh "niri msg screenshot-stdout window | satty -f -"; }

  // Quit
  Mod+Shift+E     { quit; }
  Ctrl+Alt+Delete { quit; }

  // Volume keys mappings
  XF86AudioRaiseVolume allow-when-locked=true { spawn "volctl.fish" "u"; }
  XF86AudioLowerVolume allow-when-locked=true { spawn "volctl.fish" "d"; }
  XF86AudioMute        allow-when-locked=true { spawn "volctl.fish" "m"; }
  XF86AudioMicMute     allow-when-locked=true { spawn "volctl.fish" "c"; }

  // Media keys mapping
  XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
  XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
  XF86AudioStop  allow-when-locked=true { spawn "playerctl" "stop"; }
  XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }
  XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }

  // Brightness key mappings
  XF86MonBrightnessUp   allow-when-locked=true { spawn "blctl.fish" "u" "5"; }
  XF86MonBrightnessDown allow-when-locked=true { spawn "blctl.fish" "d" "5"; }
}
